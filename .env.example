# AOKAE Dashboard - 環境変数サンプル
# このファイルをコピーして .env.local を作成し、実値を入れる
# .env.local は .gitignore 対象（絶対にコミットしない）

# ───────────────────────────────────────
# Supabase (本体: aokae-dashboard)
# ───────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
# Next.js app から参照する場合（ブラウザに露出される）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# ───────────────────────────────────────
# Supabase (soccer-tokyo 別プロジェクト)
# project: bhgvpikwhbphodswzfip
# ───────────────────────────────────────
SUPABASE_SOCCER_URL=https://bhgvpikwhbphodswzfip.supabase.co
SUPABASE_SOCCER_ANON_KEY=eyJhbGci...

# ───────────────────────────────────────
# Anthropic API (Claude Haiku - LINE レポートのコメント/タスク生成)
# ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ───────────────────────────────────────
# LINE Messaging API (オーナー通知用)
# ───────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=...
LINE_USER_ID=U...

# ───────────────────────────────────────
# GitHub (CI / line-report 等から使用)
# GitHub Actions 内では自動供給されるので通常は不要
# ローカル実行時のみ PAT を設定
# ───────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_REPOSITORY=okuwabara07-gif/aokae-dashboard

# ───────────────────────────────────────
# Vercel (Vercel CLI経由で自動生成される)
# ───────────────────────────────────────
# VERCEL_OIDC_TOKEN=（Vercel CLI が自動管理）

# ───────────────────────────────────────
# LINE レポート実行時のみ
# ───────────────────────────────────────
MODE=morning   # or evening
TZ=Asia/Tokyo
